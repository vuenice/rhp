---
// CommunitySection.astro
---

<section id="community" class="py-20 bg-slate-50/50 dark:bg-[#0A0E17]/50 border-t border-slate-200/80 dark:border-slate-800/80 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-500 border border-brand-500/20">
        Open Source & Community
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Join the Future of High-Performance Web
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        RHP is 100% open source under the MIT license. Connect with contributors, contribute to language design, and help build the runtime.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Card 1: GitHub -->
      <a
        href="https://github.com/vuenice/rhp"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-2xl bg-white dark:bg-[#0D121C] border border-slate-200 dark:border-slate-800 hover:border-brand-500/50 shadow-sm transition-all hover:-translate-y-1"
      >
        <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-800 dark:text-white mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1 group-hover:text-brand-500 transition-colors">
          GitHub Repository
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
          Explore the Rust codebase, track active pull requests, and star the project.
        </p>
        <span class="text-xs font-semibold text-brand-500 flex items-center gap-1">
          github.com/vuenice/rhp &rarr;
        </span>
      </a>

      <!-- Card 2: Discord -->
      <a
        href="https://discord.gg/rhp"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-2xl bg-white dark:bg-[#0D121C] border border-slate-200 dark:border-slate-800 hover:border-brand-500/50 shadow-sm transition-all hover:-translate-y-1"
      >
        <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-800 dark:text-white mb-4 group-hover:bg-[#5865F2] group-hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1 group-hover:text-brand-500 transition-colors">
          Discord Community
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
          Chat with core language engineers, discuss syntax RFCs, and seek assistance.
        </p>
        <span class="text-xs font-semibold text-[#5865F2] flex items-center gap-1">
          Join server &rarr;
        </span>
      </a>

      <!-- Card 3: Contributing -->
      <a
        href="/docs/contributing"
        class="group p-6 rounded-2xl bg-white dark:bg-[#0D121C] border border-slate-200 dark:border-slate-800 hover:border-brand-500/50 shadow-sm transition-all hover:-translate-y-1"
      >
        <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-800 dark:text-white mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1 group-hover:text-brand-500 transition-colors">
          Contributing Guide
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
          Setup Rust 2024, run the integration test harness, and submit your first PR.
        </p>
        <span class="text-xs font-semibold text-brand-500 flex items-center gap-1">
          Read guide &rarr;
        </span>
      </a>

      <!-- Card 4: Sponsors -->
      <a
        href="https://github.com/sponsors/vuenice"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-2xl bg-white dark:bg-[#0D121C] border border-slate-200 dark:border-slate-800 hover:border-brand-500/50 shadow-sm transition-all hover:-translate-y-1"
      >
        <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-800 dark:text-white mb-4 group-hover:bg-rose-500 group-hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1 group-hover:text-brand-500 transition-colors">
          Sponsor the Project
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
          Help fund our automated benchmarking infrastructure and developer tooling.
        </p>
        <span class="text-xs font-semibold text-rose-500 flex items-center gap-1">
          Become a sponsor &rarr;
        </span>
      </a>

    </div>

  </div>
</section>
