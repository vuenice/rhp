---
// PlaygroundTeaser.astro
import { siteUrl } from '../../lib/paths';
---

<section id="playground" class="py-20 lg:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
  <!-- Glow Accent -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-brand-500/10 blur-[140px] rounded-full pointer-events-none -z-10"></div>

  <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-500 border border-brand-500/20">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Playground App
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      RHP Playground App
    </h2>

    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
      An interactive desktop scratchpad to run RHP scripts instantly and debug Local, Docker, or Remote applications — just like <strong class="text-slate-900 dark:text-slate-200">TweakPHP</strong> for your PHP & RHP workflows.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 pt-3">
      <a
        href={siteUrl('/docs/tooling/playground')}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all hover:shadow-brand-500/35 hover:-translate-y-0.5"
      >
        <span>Try Now</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href={siteUrl('/docs/tooling/playground')}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-sm border border-slate-200 dark:border-slate-700/80 transition-all hover:-translate-y-0.5"
      >
        <span>Documentation</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

      <div class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0B0F19] border border-slate-800 text-xs font-mono text-slate-300">
        <span class="text-brand-500 select-none">$</span>
        <span>cargo run --manifest-path playground/Cargo.toml</span>
      </div>
    </div>
  </div>

  <!-- Playground Window / Image Showcase Card -->
  <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-[#0B0F19] shadow-2xl overflow-hidden group">
    <!-- Window Header -->
    <div class="flex items-center justify-between border-b border-slate-800/80 bg-[#0E1422] px-4 py-3">
      <div class="flex items-center space-x-2">
        <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
      </div>

      <div class="text-xs text-slate-400 font-medium flex items-center gap-2 font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>rhp-play &bull; Standalone & App Debugger</span>
      </div>

      <a
        href={siteUrl('/docs/tooling/playground')}
        class="text-[11px] font-mono text-brand-400 hover:text-brand-300 transition-colors flex items-center gap-1"
      >
        <span>Dedicated Guide</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- App Screenshot with Link to Docs -->
    <a
      href={siteUrl('/docs/tooling/playground')}
      class="block relative overflow-hidden focus:outline-none"
      title="Click to view RHP Playground App documentation"
    >
      <img
        src={siteUrl('/playground/rhp-play.png')}
        alt="RHP Playground desktop app interface showing interactive code execution and application debugging"
        class="w-full h-auto transition-transform duration-300 group-hover:scale-[1.006] block"
        loading="lazy"
      />

      <!-- Subtle hover overlay with CTA -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F19]/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-8">
        <span class="px-5 py-2.5 rounded-xl bg-brand-500 text-white font-semibold text-xs shadow-xl flex items-center gap-2">
          <span>Read Playground Documentation</span>
          <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </a>

    <!-- Bottom Status Bar -->
    <div class="px-4 py-2.5 bg-[#080B12] border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono text-slate-400">
      <div class="flex items-center gap-4">
        <span class="text-emerald-400 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Standalone & Multi-Host Execution Ready
        </span>
        <span class="text-slate-600 hidden sm:inline">&bull;</span>
        <span class="text-slate-400 hidden sm:inline">Local, Docker & Remote SSH</span>
      </div>
      <div class="flex items-center gap-4 text-slate-500">
        <span>GC Pause: 0.0ms</span>
        <span>&bull;</span>
        <span>Sub-millisecond JIT Startup</span>
      </div>
    </div>
  </div>

  <!-- Feature Grid Below Screenshot -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
    <div class="p-5 rounded-xl bg-white dark:bg-[#0E131F] border border-slate-200 dark:border-slate-800 shadow-sm hover:border-brand-500/30 transition-all">
      <div class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1.5">Instant Script Runner</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
        Test RHP syntax, native collection pipelines (`Arr::list`), and Tokio async futures without boilerplate, scaffolding, or server boots.
      </p>
    </div>

    <div class="p-5 rounded-xl bg-white dark:bg-[#0E131F] border border-slate-200 dark:border-slate-800 shadow-sm hover:border-brand-500/30 transition-all">
      <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1.5">Local, Docker & Remote SSH</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
        Connect directly to your local projects, Docker containers, or live staging/production servers over SSH to evaluate code in context.
      </p>
    </div>

    <div class="p-5 rounded-xl bg-white dark:bg-[#0E131F] border border-slate-200 dark:border-slate-800 shadow-sm hover:border-brand-500/30 transition-all">
      <div class="w-8 h-8 rounded-lg bg-php-500/10 text-php-400 flex items-center justify-center mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1.5">TweakPHP-Style Workflow</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
        Query application databases, call service classes, verify fixes, and inspect output with real-time memory and GC telemetry.
      </p>
    </div>
  </div>
</section>
