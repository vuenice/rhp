---
// Hero.astro
import { siteUrl } from '../../lib/paths';
const codeSnippet = `// 1. Native Rust-backed collection pipeline
list $orders = Arr::list([120, 45, 890, 15, 330])
    ->filter(fn($price) => $price > 50)
    ->map(fn($price) => $price * 1.08);

// 2. Non-blocking Tokio fiber concurrency
[$user, $metrics] = Future::wait([
    fn() => DB::table('users')->find(42),
    fn() => HTTP::get('https://api.internal/metrics')->json()
]);

// 3. Post-response cleanup hook
Future::defer(fn() => Log::info("Served user #{$user->id}"));

// 4. Instant verification: zero GC pauses
Sys::print("Peak memory: " . Memory::peak() . " bytes");`;
---

<section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
  <!-- Background Glow Accents -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-brand-500/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[300px] bg-php-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-slate-800 dark:text-slate-300">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>RHP v0.1.0-alpha Released</span>
          <span class="text-slate-400">·</span>
          <a href={siteUrl('/docs/getting-started/installation')} class="text-brand-500 hover:underline flex items-center gap-1 font-semibold">
            Read docs <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.12]">
          A Rust-Powered, <br />
          <span class="bg-gradient-to-r from-brand-500 via-brand-400 to-php-500 bg-clip-text text-transparent">PHP-Family Language</span> <br />
          for Fast Web Backends
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Supercharge Laravel-style apps with the raw speed, memory safety, and zero-GC predictability of Rust. Eliminate per-request bootstrapping without complex workarounds.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href={siteUrl('/docs/getting-started/installation')}
            class="px-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all hover:shadow-brand-500/35 hover:-translate-y-0.5"
          >
            Get Started
          </a>
          <a
            href="https://github.com/vuenice/rhp"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-sm border border-slate-200 dark:border-slate-700/80 transition-all hover:-translate-y-0.5 flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
            <span>View on GitHub</span>
          </a>
        </div>

        <!-- One-line install command with copy button -->
        <div class="pt-4 max-w-md mx-auto lg:mx-0">
          <div class="relative flex items-center justify-between rounded-xl bg-slate-900 dark:bg-[#0E131F] border border-slate-800 dark:border-slate-800/80 px-4 py-3 shadow-lg">
            <div class="flex items-center gap-3 overflow-x-auto text-xs sm:text-sm font-mono text-slate-200">
              <span class="text-brand-500 font-bold select-none">$</span>
              <span id="hero-install-cmd">brew install vuenice/rhp/rhp</span>
            </div>
            <button
              id="copy-hero-install"
              type="button"
              class="ml-3 p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors focus:outline-none"
              aria-label="Copy install command"
            >
              <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <svg id="check-icon" class="w-4 h-4 text-emerald-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 text-center lg:text-left">
            Or via Cargo: <code class="font-mono text-slate-400">cargo install rhp</code>
          </p>
        </div>

      </div>

      <!-- Right Column: Real Code Sample Window Beside Hero -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-[#0B0F19] shadow-2xl overflow-hidden font-mono text-xs sm:text-sm">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-[#0E1422] border-b border-slate-800/80">
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            <div class="text-xs text-slate-400 font-medium flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-brand-500"></span>
              index.rhp
            </div>
            <span class="text-[10px] text-slate-500 bg-slate-800/60 px-2 py-0.5 rounded">RHP 0.1</span>
          </div>

          <!-- Code Content -->
          <div class="p-4 sm:p-5 text-slate-300 leading-relaxed overflow-x-auto">
            <pre class="leading-relaxed"><code>{codeSnippet}</code></pre>
          </div>

          <!-- Bottom execution status bar -->
          <div class="px-4 py-2 bg-[#090D15] border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span class="flex items-center gap-1.5 text-emerald-400 font-mono">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              rhp run dev &bull; 0.4ms startup
            </span>
            <span class="font-mono text-slate-500">GC Pause: 0.0ms</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-hero-install');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');

  if (copyBtn && copyIcon && checkIcon) {
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText('brew install vuenice/rhp/rhp');
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      setTimeout(() => {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 2000);
    });
  }
</script>
