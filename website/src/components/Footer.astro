---
import { siteUrl } from '../lib/paths';
---

<footer class="border-t border-slate-200 dark:border-slate-850 bg-slate-50 dark:bg-[#07090E] transition-colors mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 lg:gap-12">
      
      <!-- Brand & Mission Column -->
      <div class="col-span-2">
        <a href={siteUrl('/')} class="flex items-center space-x-3 mb-4 group">
          <img src={siteUrl('/rhp-logo.svg')} alt="RHP Logo" class="w-8 h-8 group-hover:scale-105 transition-transform" />
          <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">RHP</span>
          <span class="text-xs font-mono text-brand-500 bg-brand-500/10 px-2 py-0.5 rounded-full border border-brand-500/20">v0.1.0-alpha</span>
        </a>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-sm mb-6 leading-relaxed">
          A high-performance, drop-in syntax programming language designed to supercharge PHP and Laravel-style applications with the raw speed, zero-GC pauses, and memory safety of Rust.
        </p>
        <div class="flex items-center space-x-4 text-slate-400 dark:text-slate-500">
          <a href="https://github.com/vuenice/rhp" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
          </a>
          <a href="https://discord.gg/DdCn4ySEv" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="Discord">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </a>
          <a href="https://x.com/rhplang" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="X / Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Docs Navigation -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white mb-4">Documentation</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href={siteUrl('/docs/getting-started/installation')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Installation</a></li>
          <li><a href={siteUrl('/docs/getting-started/hello-world')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Hello World</a></li>
          <li><a href={siteUrl('/docs/guide/variables-and-types')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Variables & Types</a></li>
          <li><a href={siteUrl('/docs/guide/concurrency-async')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Async & Concurrency</a></li>
          <li><a href={siteUrl('/docs/guide/standard-library')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Standard Library</a></li>
          <li><a href={siteUrl('/docs/reference/grammar')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Grammar Reference</a></li>
        </ul>
      </div>

      <!-- Tooling & Advanced -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white mb-4">Architecture</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href={siteUrl('/docs/advanced/memory-model')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Zero-GC Memory Model</a></li>
          <li><a href={siteUrl('/docs/advanced/compiler-internals')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Compiler & VM Internals</a></li>
          <li><a href={siteUrl('/docs/advanced/ffi-interop')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Rust FFI & Plugins</a></li>
          <li><a href={siteUrl('/docs/tooling/linter')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Linter & Auto-Typing</a></li>
          <li><a href={siteUrl('/docs/tooling/editor-setup')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">VS Code & LSP Setup</a></li>
        </ul>
      </div>

      <!-- Community & Resources -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white mb-4">Ecosystem</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href={siteUrl('/docs/contributing')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Contributing Guide</a></li>
          <li><a href={siteUrl('/docs/changelog')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Changelog & Releases</a></li>
          <li><a href={siteUrl('/docs/faq')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">FAQ & Trade-offs</a></li>
          <li><a href="https://github.com/vuenice/rhp/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">MIT License</a></li>
          <li><a href={siteUrl('/docs/tooling/playground')} class="text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Playground App</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-4">
      <div>
        © 2026 RHP Core Contributors. Released under the <a href="https://github.com/vuenice/rhp" class="underline hover:text-brand-500">MIT License</a>.
      </div>
      <div class="flex items-center space-x-6">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Engine Core: v0.1.0-alpha (Rust 2024 / Cranelift JIT)
        </span>
        <a href="https://github.com/vuenice/rhp" target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors">GitHub Repository</a>
      </div>
    </div>
  </div>
</footer>
