{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "rhp",
  "scopeName": "source.rhp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#facades" },
    { "include": "#types" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rhp",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.rhp",
          "match": "#.*$"
        },
        {
          "name": "comment.block.rhp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rhp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rhp",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolated.rhp",
              "match": "\\$([a-zA-Z_][a-zA-Z0-9_]*)"
            },
            {
              "name": "variable.other.interpolated.complex.rhp",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.rhp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.rhp",
              "match": "\\\\['\\\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.rhp",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.rhp",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.rhp",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.rhp",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.this.rhp",
          "match": "\\$this\\b"
        },
        {
          "name": "variable.language.superglobal.rhp",
          "match": "\\$_(GET|POST|FILES|COOKIE|SESSION|SERVER|ENV)\\b"
        },
        {
          "name": "variable.other.rhp",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rhp",
          "match": "\\b(if|else|elseif|while|do|for|foreach|as|break|continue|switch|case|default|match|return|try|catch|finally|throw|yield)\\b"
        },
        {
          "name": "keyword.other.rhp",
          "match": "\\b(class|interface|trait|enum|singleton|extends|implements|new|use|namespace|const|public|protected|private|static|final|abstract|readonly|fn|function|async|defer|macro)\\b"
        }
      ]
    },
    "facades": {
      "patterns": [
        {
          "name": "support.class.facade.rhp",
          "match": "\\b(Arr|Str|Future|Memory|File|HTTP|Log|Sys|Weak|DB|Session|Image|URL|Int|Float|Glob|phpFun)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.rhp",
          "match": "\\b(int|float|string|bool|void|mixed|array|list|dict|set|hashmap|callable|iterable|object|never|null|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rhp",
          "match": "\\b(true|false|null|TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rhp",
          "match": "(?<=function\\s+)([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "name": "entity.name.function.call.rhp",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rhp",
          "match": "(->|::|=>|\\?\\?=|\\?\\?|\\?:|===|!==|==|!=|<=|>=|<|>|&&|\\|\\||!|\\+|-|\\*|/|%|\\*\\*|&|\\||\\^|~|<<|>>|=)"
        }
      ]
    }
  }
}
