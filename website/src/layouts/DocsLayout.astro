---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { docsNavigation, getPrevNextDocs } from '../data/docsNav';
import { siteUrl } from '../lib/paths';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  section?: string;
  slug: string;
  headings?: Heading[];
  keywords?: string | string[];
}

const { title, description, section, slug, headings = [], keywords } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const { prev, next } = getPrevNextDocs(slug);

const githubEditUrl = `https://github.com/vuenice/rhp/edit/main/website/src/content/docs/${slug}.md`;
const markdownUrl = siteUrl(`/docs/${slug}.md`);
const jsonUrl = siteUrl(`/docs/${slug}.json`);
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<Layout
  title={`${title} · RHP Docs`}
  description={description}
  keywords={keywords}
  alternateMarkdown={markdownUrl}
  alternateJson={jsonUrl}
>
  <Navbar />
  <SearchModal />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex-1">
    <div class="flex flex-col lg:flex-row gap-8 py-8 lg:py-10">
      
      <!-- Mobile Sidebar Toggle -->
      <div class="lg:hidden flex items-center justify-between p-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 mb-2">
        <button
          id="docs-sidebar-toggle"
          type="button"
          class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-200"
        >
          <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          <span>Menu &bull; {section || 'Documentation'}</span>
        </button>
        <span class="text-xs text-slate-400 font-mono">v0.1.0-alpha</span>
      </div>

      <!-- Left Sidebar (Desktop fixed/sticky, Mobile drawer) -->
      <aside
        id="docs-sidebar"
        class="hidden lg:block w-full lg:w-64 flex-shrink-0 lg:sticky lg:top-24 h-auto lg:h-[calc(100vh-8rem)] overflow-y-auto pr-4 space-y-6 text-sm"
      >
        <!-- Version Selector Stub -->
        <div class="pb-3 border-b border-slate-200 dark:border-slate-800">
          <label for="version-select" class="block text-[11px] font-mono text-slate-400 mb-1.5 uppercase tracking-wider">Language Version</label>
          <select
            id="version-select"
            class="w-full bg-slate-100 dark:bg-[#0E1420] border border-slate-300 dark:border-slate-700/80 text-slate-800 dark:text-slate-200 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-brand-500 font-mono"
          >
            <option value="v0.1.0-alpha" selected>v0.1.0-alpha (current)</option>
            <option value="v0.2.0-dev">v0.2.0-dev (preview)</option>
            <option value="v0.0.9">v0.0.9 (legacy)</option>
          </select>
        </div>

        <!-- Navigation Sections -->
        <nav class="space-y-6">
          {docsNavigation.map((sec) => (
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-2.5">
                {sec.title}
              </h4>
              <ul class="space-y-1 border-l border-slate-200 dark:border-slate-800">
                {sec.items.map((item) => {
                  const isActive = currentPath === item.href || currentPath.endsWith(item.slug);
                  return (
                    <li>
                      <a
                        href={item.href}
                        class={`group -ml-px flex items-center pl-3 py-1.5 text-xs transition-colors border-l-2 ${
                          isActive
                            ? 'font-semibold text-brand-500 border-brand-500 bg-brand-500/5'
                            : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border-transparent hover:border-slate-300 dark:hover:border-slate-700'
                        }`}
                      >
                        {item.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Center Content Area -->
      <main class="flex-1 min-w-0 max-w-3xl">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
          <a href={siteUrl('/docs/getting-started/installation')} class="hover:text-brand-500">Docs</a>
          <span>/</span>
          {section && (
            <>
              <span class="text-slate-400 dark:text-slate-500">{section}</span>
              <span>/</span>
            </>
          )}
          <span class="text-brand-500 font-medium truncate">{title}</span>
        </nav>

        <!-- Document Heading -->
        <header class="mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-3">
            {title}
          </h1>
          {description && (
            <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
              {description}
            </p>
          )}
        </header>

        <!-- Markdown Body -->
        <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-28 prose-a:text-brand-500 hover:prose-a:underline prose-code:font-mono">
          <slot />
        </article>

        <!-- Structured Data & Machine-Readable AI Knowledge Base (Invisible to visual users) -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "TechArticle",
          "headline": title,
          "description": description,
          "keywords": Array.isArray(keywords) ? keywords.join(", ") : (keywords || "RHP, PHP, rust, programming language, documentation"),
          "url": Astro.url.href,
          "inLanguage": "en-US",
          "mainEntityOfPage": Astro.url.href,
          "articleSection": section || "Documentation",
          "author": {
            "@type": "Organization",
            "name": "RHP Project",
            "url": "https://rhp.dev"
          }
        })} />

        {slug === 'reference/unsupported-php' && (
          <>
            <script type="application/json" id="ai-context" data-purpose="ai-agent-knowledge-base" is:inline set:html={JSON.stringify({
              "topic": "Deprecated and Unsupported PHP Features in RHP",
              "canonical_url": Astro.url.href,
              "markdown_source": markdownUrl,
              "json_source": jsonUrl,
              "summary": "Exhaustive guide to deprecated and unsupported PHP features in RHP, reasons for rejection, and modern RHP replacements.",
              "deprecated_features": [
                {
                  "name": "error_reporting",
                  "status": "deprecated_and_unsupported",
                  "php_constructs": ["error_reporting()", "set_error_handler()", "restore_error_handler()", "@ error suppression", "E_ALL", "E_NOTICE", "E_WARNING", "E_DEPRECATED", "E_STRICT"],
                  "reason": "Process-global mutable error bitmask causes race conditions in concurrent Tokio workers and hides bugs.",
                  "rhp_replacement": "Compiler diagnostics, declarative rhp.toml [logging], structured Log facade, and explicit try-catch / Result types."
                },
                {
                  "name": "Reflection API",
                  "status": "unsupported",
                  "php_constructs": ["ReflectionClass", "ReflectionMethod", "ReflectionProperty", "ReflectionFunction", "ReflectionParameter"],
                  "reason": "Runtime overhead, breaks JIT invariants and dead code elimination.",
                  "rhp_replacement": "Build-time DI codegen, static ProgramMetadata table, compile-time attribute discovery."
                },
                {
                  "name": "Output Buffering API",
                  "status": "unsupported",
                  "php_constructs": ["ob_start()", "ob_get_clean()", "ob_end_clean()", "ob_get_contents()", "ob_end_flush()", "ob_implicit_flush()"],
                  "reason": "Process-global state leaks across persistent workers; unsafe in async fibers.",
                  "rhp_replacement": "Output::capture(fn() => ...), direct Writer templates, Response::stream."
                },
                {
                  "name": "cURL Extension",
                  "status": "unsupported",
                  "php_constructs": ["curl_init()", "curl_setopt()", "curl_exec()", "curl_multi_*"],
                  "reason": "Untypable integer constant API, missing safe timeouts, redundant wrapper layer over native Rust clients.",
                  "rhp_replacement": "Fluent Http facade, async AHTTP, Tokio asynchronous concurrency."
                },
                {
                  "name": "Legacy Object Serialization",
                  "status": "unsupported",
                  "php_constructs": ["serialize()", "unserialize()", "__sleep()", "__wakeup()"],
                  "reason": "Pervasive RCE gadget chains, open-by-default class loading, slow string format.",
                  "rhp_replacement": "Compact binary format, __serialize()/__unserialize(dict), #[Transient], deny-by-default allowed_classes."
                },
                {
                  "name": "Strict Operators & Loose Coercion",
                  "status": "unsupported",
                  "php_constructs": ["===", "!==", "loose =="],
                  "reason": "Implicit type coercion causes security vulnerabilities; redundant === syntax in strictly typed language.",
                  "rhp_replacement": "Strict ==/!=, compile-time mismatch errors, Bool/Str/Int/Float/Array::compare*."
                },
                {
                  "name": "Directive Statements",
                  "status": "unsupported",
                  "php_constructs": ["declare(strict_types=1);", "declare(ticks=1);"],
                  "reason": "Redundant per-file boilerplate; caller-dependent type semantics; ticks cripple JIT.",
                  "rhp_replacement": "Universal compiler-enforced strict typing, Tokio fiber runtime & OpenTelemetry."
                },
                {
                  "name": "Classic list() Destructuring",
                  "status": "unsupported",
                  "php_constructs": ["list($a, $b) = $array"],
                  "reason": "Lexical keyword collision with list collection type; archaic syntax.",
                  "rhp_replacement": "Square-bracket destructuring [$a, $b] = $array; dedicated list collection type."
                },
                {
                  "name": "die() Construct",
                  "status": "unsupported",
                  "php_constructs": ["die()", "die('message')"],
                  "reason": "Abrupt process termination crashes persistent workers; bypasses exception unwinding; emits raw string with 200 OK.",
                  "rhp_replacement": "Typed exceptions (throw new ...), abort(status, msg), Response::json(...), Sys::exit($code)."
                }
              ]
            })} />

            <div hidden id="ai-knowledge-base" aria-hidden="true" class="hidden">
              <h3>AI Agent Reference: Deprecated &amp; Unsupported PHP Features in RHP</h3>
              <p>
                RHP deliberately departs from legacy PHP runtime semantics. The following features are deprecated or unsupported:
                1. error_reporting(), set_error_handler(), and the @ error suppression operator (replaced by declarative rhp.toml [logging], structured Log facade, compile-time diagnostics, and explicit try-catch / Result types).
                2. Reflection API (replaced by build-time DI codegen and static compile-time metadata).
                3. Output Buffering ob_* (replaced by Output::capture and streaming writers).
                4. cURL extension curl_* (replaced by fluent Http facade and async AHTTP).
                5. Legacy Serialization serialize/unserialize (replaced by secure binary format and Json).
                6. Strict/Loose Comparison === and loose == (replaced by strict == and compile-time type checking).
                7. Directive Statements declare(...) (replaced by compiler defaults).
                8. Classic list() (replaced by [$a, $b] array destructuring).
                9. die() (replaced by typed exceptions, abort(), and Sys::exit()).
              </p>
            </div>
          </>
        )}

        <!-- Document Footer: Edit on GitHub, AI links & Previous/Next Navigation -->
        <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 space-y-8">
          
          <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
            <div class="flex items-center gap-4">
              <a
                href={githubEditUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 hover:text-brand-500 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                <span>Edit this page on GitHub</span>
              </a>
              <span class="text-slate-300 dark:text-slate-700">&bull;</span>
              <!-- AI Bot / LLM Clean Format Links -->
              <a
                href={markdownUrl}
                target="_blank"
                class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 hover:border-brand-500 text-slate-600 dark:text-slate-300 transition-colors"
                title="View clean raw Markdown for AI bots and LLMs"
              >
                <svg class="w-3 h-3 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span>Raw .md (AI)</span>
              </a>
              <a
                href={jsonUrl}
                target="_blank"
                class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 hover:border-brand-500 text-slate-600 dark:text-slate-300 transition-colors"
                title="View structured JSON format for AI agents"
              >
                <span class="font-bold text-[10px] text-brand-500">&#123;&#125;</span>
                <span>JSON (AI)</span>
              </a>
            </div>
            <span>Last verified for RHP v0.1.0-alpha</span>
          </div>

          <!-- Prev / Next Navigation Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prev ? (
              <a
                href={prev.href}
                class="group p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0D121C] hover:border-brand-500/50 transition-all text-left"
              >
                <span class="block text-[11px] font-mono text-slate-400 group-hover:text-brand-500 transition-colors">&larr; Previous</span>
                <span class="text-sm font-semibold text-slate-900 dark:text-white mt-0.5 block">{prev.title}</span>
              </a>
            ) : <div />}

            {next ? (
              <a
                href={next.href}
                class="group p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0D121C] hover:border-brand-500/50 transition-all text-right sm:col-start-2"
              >
                <span class="block text-[11px] font-mono text-slate-400 group-hover:text-brand-500 transition-colors">Next &rarr;</span>
                <span class="text-sm font-semibold text-slate-900 dark:text-white mt-0.5 block">{next.title}</span>
              </a>
            ) : null}
          </div>

        </div>

      </main>

      <!-- Right "On this page" Table of Contents (TOC) -->
      <aside class="hidden xl:block w-60 flex-shrink-0 sticky top-24 h-[calc(100vh-8rem)] overflow-y-auto pl-4 text-xs">
        <div class="border-l border-slate-200 dark:border-slate-800 pl-4 py-1 space-y-3">
          <h5 class="font-bold uppercase tracking-wider text-slate-900 dark:text-white text-[11px]">
            On this page
          </h5>
          {tocHeadings.length > 0 ? (
            <ul class="space-y-2">
              {tocHeadings.map(h => (
                <li class={h.depth === 3 ? 'pl-2' : ''}>
                  <a
                    href={`#${h.slug}`}
                    class="toc-link block text-slate-600 dark:text-slate-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors leading-snug"
                    data-slug={h.slug}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-slate-400">Overview topic</p>
          )}

          <div class="pt-4 border-t border-slate-200 dark:border-slate-800">
            <a href="#top" class="text-slate-400 hover:text-slate-200 flex items-center gap-1 font-mono">
              &uarr; Back to top
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>

  <Footer />
</Layout>

<script>
  // Mobile drawer toggle
  const sidebarBtn = document.getElementById('docs-sidebar-toggle');
  const sidebar = document.getElementById('docs-sidebar');
  if (sidebarBtn && sidebar) {
    sidebarBtn.addEventListener('click', () => {
      sidebar.classList.toggle('hidden');
    });
  }

  // Code block copy button and language tag injection (VitePress style)
  function enhanceCodeBlocks() {
    document.querySelectorAll('pre').forEach(pre => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      // Extract language from attribute or code class (e.g. data-language="php")
      const code = pre.querySelector('code');
      const langData = pre.getAttribute('data-language');
      const langClass = Array.from(code?.classList || []).find(c => c.startsWith('language-'));
      let lang = langData || (langClass ? langClass.replace('language-', '') : '');
      if (lang === 'text') lang = '';

      // Wrap the <pre> so the badge/button stay fixed while long lines scroll horizontally.
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      // VitePress language badge (visible in top-right)
      if (lang) {
        const langBadge = document.createElement('span');
        langBadge.className = 'code-lang-label';
        langBadge.textContent = lang;
        wrapper.appendChild(langBadge);
      }

      // VitePress copy button
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'code-copy-btn';
      copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
      copyBtn.setAttribute('title', 'Copy code');
      copyBtn.innerHTML = `
        <svg class="w-4 h-4 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      `;

      copyBtn.addEventListener('click', async () => {
        const text = code?.textContent || pre.textContent || '';
        await navigator.clipboard.writeText(text);
        copyBtn.classList.add('copied');
        copyBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        `;
        setTimeout(() => {
          copyBtn.classList.remove('copied');
          copyBtn.innerHTML = `
            <svg class="w-4 h-4 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          `;
        }, 1800);
      });

      wrapper.appendChild(copyBtn);
    });
  }

  // Scrollspy for TOC
  function setupScrollspy() {
    const links = document.querySelectorAll('.toc-link');
    const headingElements = Array.from(document.querySelectorAll('article h2, article h3'));

    if (headingElements.length === 0 || links.length === 0) return;

    window.addEventListener('scroll', () => {
      let activeId = '';
      for (const el of headingElements) {
        const top = el.getBoundingClientRect().top;
        if (top <= 120) {
          activeId = el.id;
        } else {
          break;
        }
      }

      links.forEach(l => {
        if (l.getAttribute('data-slug') === activeId) {
          l.classList.add('text-brand-500', 'font-semibold');
          l.classList.remove('text-slate-600', 'dark:text-slate-400');
        } else {
          l.classList.remove('text-brand-500', 'font-semibold');
          l.classList.add('text-slate-600', 'dark:text-slate-400');
        }
      });
    }, { passive: true });
  }

  enhanceCodeBlocks();
  setupScrollspy();
  document.addEventListener('astro:after-swap', () => {
    enhanceCodeBlocks();
    setupScrollspy();
  });
</script>
