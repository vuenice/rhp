        $listHtml = self::renderList($todos, $filter, $stats);

        $html = "<!DOCTYPE html>\n";
        $html = $html . "<html lang=\"en\">\n";
        $html = $html . "<head>\n";
        $html = $html . "  <meta charset=\"UTF-8\" />\n";
        $html = $html . "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n";
        $html = $html . "  <title>RHP Todo App - Rust-Powered PHP</title>\n";
        $html = $html . "  <script src=\"https://cdn.tailwindcss.com\"></script>\n";
        $html = $html . "  <script src=\"https://unpkg.com/htmx.org@1.9.12\"></script>\n";
        $html = $html . "  <script defer src=\"https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n";
        $html = $html . "  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n";
        $html = $html . "  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n";
        $html = $html . "  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n";
        $html = $html . "  <style>\n";
        $html = $html . "    body { font-family: 'Plus Jakarta Sans', sans-serif; }\n";
        $html = $html . "    .htmx-request .spinner { display: inline-block; }\n";
        $html = $html . "    .spinner { display: none; }\n";
        $html = $html . "  </style>\n";
        $html = $html . "</head>\n";
        $html = $html . "<body class=\"bg-slate-100 min-h-screen text-slate-800 antialiased selection:bg-indigo-500 selection:text-white\">\n";
        $html = $html . "  <div class=\"max-w-2xl mx-auto px-4 py-12\">\n";

        // Header section
        $html = $html . "    <header class=\"mb-8 text-center\">\n";
        $html = $html . "      <div class=\"inline-flex items-center space-x-2 px-3 py-1 bg-indigo-50 border border-indigo-200/60 rounded-full text-indigo-700 text-xs font-semibold mb-3\">\n";
        $html = $html . "        <span class=\"flex h-2 w-2 relative\">\n";
        $html = $html . "          <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75\"></span>\n";
        $html = $html . "          <span class=\"relative inline-flex rounded-full h-2 w-2 bg-indigo-500\"></span>\n";
        $html = $html . "        </span>\n";
        $html = $html . "        <span>RHP Engine • Rust Register VM Bytecode</span>\n";
        $html = $html . "      </div>\n";
        $html = $html . "      <h1 class=\"text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl\">\n";
        $html = $html . "        TaskFlow <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500\">RHP</span>\n";
        $html = $html . "      </h1>\n";
        $html = $html . "      <p class=\"mt-2.5 text-sm text-slate-600 max-w-md mx-auto\">\n";
        $html = $html . "        Reactive TODO application powered by <strong>RHP</strong> backend, <strong>HTMX</strong> server-driven partials, and <strong>Alpine.js</strong>.\n";
        $html = $html . "      </p>\n";
        $html = $html . "    </header>\n";

        // Main card
        $html = $html . "    <main class=\"bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden\">\n";

        // Form to add a new task
        $html = $html . "      <section class=\"p-6 sm:p-8 bg-gradient-to-b from-indigo-50/40 via-white to-white border-b border-slate-100\">\n";
        $html = $html . "        <form\n";
        $html = $html . "          hx-post=\"/todos\"\n";
        $html = $html . "          hx-target=\"#todo-list-container\"\n";
        $html = $html . "          hx-swap=\"innerHTML\"\n";
        $html = $html . "          hx-on::after-request=\"this.reset();\"\n";
        $html = $html . "          class=\"space-y-3\">\n";
        $html = $html . "          <div class=\"flex flex-col sm:flex-row gap-2.5\">\n";
        $html = $html . "            <div class=\"relative flex-1\">\n";
        $html = $html . "              <input\n";
        $html = $html . "                type=\"text\"\n";
        $html = $html . "                name=\"title\"\n";
        $html = $html . "                required\n";
        $html = $html . "                placeholder=\"What needs to be accomplished today?\"\n";
        $html = $html . "                class=\"w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition shadow-sm\" />\n";
        $html = $html . "            </div>\n";
