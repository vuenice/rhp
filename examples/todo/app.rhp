        $html = $html . "              <option value=\"General\">General</option>\n";
        $html = $html . "              <option value=\"Core\">Core</option>\n";
        $html = $html . "              <option value=\"Frontend\">Frontend</option>\n";
        $html = $html . "              <option value=\"DevOps\">DevOps</option>\n";
        $html = $html . "            </select>\n";
        $html = $html . "            <button\n";
        $html = $html . "              type=\"submit\"\n";
        $html = $html . "              class=\"px-5 py-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold text-sm rounded-xl shadow-md shadow-indigo-500/20 transition duration-150 flex items-center justify-center space-x-1.5 shrink-0\">\n";
        $html = $html . "              <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M12 4v16m8-8H4\"></path></svg>\n";
        $html = $html . "              <span>Add Task</span>\n";
        $html = $html . "            </button>\n";
        $html = $html . "          </div>\n";
        $html = $html . "        </form>\n";
        $html = $html . "      </section>\n";

        // Todo list container
        $html = $html . "      <section class=\"p-6 sm:p-8\">\n";
        $html = $html . $listHtml;
        $html = $html . "      </section>\n";

        $html = $html . "    </main>\n";

        // Footer info
        $html = $html . "    <footer class=\"mt-8 text-center text-xs text-slate-400 space-y-1.5\">\n";
        $html = $html . "      <p>Drop-in PHP syntax running on <strong>Rust Register VM Bytecode</strong></p>\n";
        $html = $html . "      <div class=\"flex justify-center items-center space-x-3 text-indigo-600 font-medium pt-1\">\n";
        $html = $html . "        <a href=\"/api/todos\" target=\"_blank\" class=\"hover:underline\">Inspect JSON API</a>\n";
        $html = $html . "        <span>•</span>\n";
        $html = $html . "        <span>Zero-Bootstrap Worker Pool</span>\n";
        $html = $html . "      </div>\n";
        $html = $html . "    </footer>\n";

        $html = $html . "  </div>\n";
        $html = $html . "</body>\n";
        $html = $html . "</html>\n";

        return $html;
    }
}

// =========================================================================
// Main Execution & Request Handling
// =========================================================================

// Read superglobals when invoked via Web/WorkerRequest
global $_GET, $_POST, $_SERVER;

$filePath = "";
if ($_SERVER != null && $_SERVER->has("TODOS_FILE")) {
    $filePath = string($_SERVER["TODOS_FILE"]);
}
$store = new TodoStore($filePath);

$method = "GET";
$uri = "/";
$isHtmx = false;

if ($_SERVER != null) {
    if ($_SERVER->has("REQUEST_METHOD")) {
        $method = $_SERVER["REQUEST_METHOD"];
    }
    if ($_SERVER->has("REQUEST_URI")) {
        $uri = $_SERVER["REQUEST_URI"];
    }
    if ($_SERVER->has("HTTP_HX_REQUEST")) {
        $isHtmx = true;
    }
}

// 1. POST /todos -> Add a new task
if ($method == "POST" && Str::startsWith($uri, "/todos") && !Str::contains($uri, "toggle") && !Str::contains($uri, "delete") && !Str::contains($uri, "clear-completed")) {
    $title = "New task";
    $category = "General";
    if ($_POST != null) {
        if ($_POST->has("title")) {
            $title = $_POST["title"];
        }
        if ($_POST->has("category")) {
            $category = $_POST["category"];
        }
    }
    $store->add($title, $category);
    $stats = $store->getStats();
    echo TodoRenderer::renderList($store->todos, "all", $stats);
    return;
}

// 2. POST /todos/toggle -> Toggle a task
if ($method == "POST" && Str::contains($uri, "/todos/toggle")) {
    $id = 1;
    if ($_GET != null && $_GET->has("id")) {
        $id = int($_GET["id"]);
    } elseif ($_POST != null && $_POST->has("id")) {
        $id = int($_POST["id"]);
    }
    $store->toggle($id);
    $stats = $store->getStats();
    echo TodoRenderer::renderList($store->todos, "all", $stats);
    return;
}

// 3. POST /todos/delete -> Delete a task
if ($method == "POST" && Str::contains($uri, "/todos/delete")) {
    $id = 1;
    if ($_GET != null && $_GET->has("id")) {
        $id = int($_GET["id"]);
    } elseif ($_POST != null && $_POST->has("id")) {
        $id = int($_POST["id"]);
    }
    $store->delete($id);
    $stats = $store->getStats();
    echo TodoRenderer::renderList($store->todos, "all", $stats);
    return;
}

// 4. POST /todos/clear-completed -> Clear all completed tasks
if ($method == "POST" && Str::contains($uri, "/todos/clear-completed")) {
    $store->clearCompleted();
    $stats = $store->getStats();
    echo TodoRenderer::renderList($store->todos, "all", $stats);
    return;
}

// 5. GET /api/todos -> JSON representation
if (Str::startsWith($uri, "/api/todos")) {
    $stats = $store->getStats();
    echo $stats->toJson();
    return;
}

// 6. Default / GET -> Full page or partial based on filter
$filter = "all";
if ($_GET != null && $_GET->has("filter")) {
    $filter = $_GET["filter"];
}

$filtered = $store->getFiltered($filter);
$stats = $store->getStats();

if ($isHtmx) {
    // If request is from HTMX filter tab, return only the list fragment!
    echo TodoRenderer::renderList($filtered, $filter, $stats);
} else {
    // Standard browser visit: return the complete styled HTML page
    echo TodoRenderer::renderFullPage($filtered, $filter, $stats);
}
